{
  "name": "tam-an-be",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build:auth": "nest build auth-service",
    "build:users": "nest build users-service",
    "build": "npm run build:auth && npm run build:users",
    "format": "prettier --write \"apps/**/*.ts\" \"libs/**/*.ts\"",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:users": "nest start users-service",
    "start:users:dev": "nest start users-service --watch",
    "start:prod:auth": "node dist/apps/auth-service/main",
    "start:prod:users": "node dist/apps/users-service/main",
    "generate:jwt-keypair": "ts-node -r tsconfig-paths/register apps/auth-service/scripts/generate-jwt-keypair.ts",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e:auth": "jest --config ./apps/auth-service/test/jest-e2e.json",
    "test:e2e:users": "jest --config ./apps/users-service/test/jest-e2e.json",
    "typeorm:auth": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/auth-service/src/database/data-source.ts",
    "typeorm:users": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js -d apps/users-service/src/database/data-source.ts",
    "migration:generate:auth": "npm run typeorm:auth -- migration:generate",
    "migration:run:auth": "npm run typeorm:auth -- migration:run",
    "migration:revert:auth": "npm run typeorm:auth -- migration:revert",
    "migration:generate:users": "npm run typeorm:users -- migration:generate",
    "migration:run:users": "npm run typeorm:users -- migration:run",
    "migration:revert:users": "npm run typeorm:users -- migration:revert",
    "seed:auth": "ts-node -r tsconfig-paths/register apps/auth-service/src/database/seeds/seed-users.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.1",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/swagger": "^11.4.5",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^11.0.3",
    "@sendgrid/mail": "^8.1.6",
    "argon2": "^0.44.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "google-auth-library": "^11.0.2",
    "joi": "^18.2.3",
    "jsonwebtoken": "^9.0.3",
    "jwks-rsa": "^3.2.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.30",
    "typeorm-naming-strategies": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^7.0.0",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "./coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@shared-auth$": "<rootDir>/libs/shared-auth/src",
      "^@shared-auth/(.*)$": "<rootDir>/libs/shared-auth/src/$1",
      "^@shared-common$": "<rootDir>/libs/shared-common/src",
      "^@shared-common/(.*)$": "<rootDir>/libs/shared-common/src/$1"
    }
  }
}