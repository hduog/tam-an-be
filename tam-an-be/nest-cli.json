{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/auth-service/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "plugins": [
      "@nestjs/swagger"
    ],
    "webpack": true,
    "tsConfigPath": "apps/auth-service/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/auth-service",
  "projects": {
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "users-service": {
      "type": "application",
      "root": "apps/users-service",
      "entryFile": "main",
      "sourceRoot": "apps/users-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/users-service/tsconfig.app.json"
      }
    },
    "shared-auth": {
      "type": "library",
      "root": "libs/shared-auth",
      "entryFile": "index",
      "sourceRoot": "libs/shared-auth/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-auth/tsconfig.lib.json"
      }
    },
    "shared-common": {
      "type": "library",
      "root": "libs/shared-common",
      "entryFile": "index",
      "sourceRoot": "libs/shared-common/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared-common/tsconfig.lib.json"
      }
    }
  }
}
