# Copy file này thành apps/users-service/.env rồi điền giá trị thật.
# Không commit file .env thật (đã có trong .gitignore).

NODE_ENV=development
USERS_SERVICE_PORT=3002

# Postgres — khớp users-postgres trong docker-compose.yml (port 5434)
USERS_DB_HOST=localhost
USERS_DB_PORT=5434
USERS_DB_USER=tam_an
USERS_DB_PASSWORD=tam_an_password
USERS_DB_NAME=users_db

# JWKS thật của auth-service — users-service không giữ key nào cả, chỉ
# fetch + cache public key từ endpoint này để verify access token (RS256).
AUTH_JWKS_URI=http://localhost:3001/auth/jwks.json

# Xác thực service-to-service cho POST/DELETE /internal/users — PHẢI
# TRÙNG giá trị với INTERNAL_API_KEY trong apps/auth-service/.env.
INTERNAL_API_KEY=doi-chuoi-nay-toi-thieu-32-ky-tu-ngau-nhien-khac
