# Copy file này thành apps/auth-service/.env rồi điền giá trị thật.
# Không commit file .env thật (đã có trong .gitignore).

NODE_ENV=development
AUTH_SERVICE_PORT=3001

# Postgres — khớp auth-postgres trong docker-compose.yml (port 5433)
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5433
AUTH_DB_USER=tam_an
AUTH_DB_PASSWORD=tam_an_password
AUTH_DB_NAME=auth_db

# Chỉ dùng cho email-verification token (nội bộ auth-service, không
# xuyên service) — KHÔNG phải secret ký access token, xem JWT_PRIVATE_KEY.
JWT_ACCESS_SECRET=doi-chuoi-nay-toi-thieu-32-ky-tu-ngau-nhien
JWT_ACCESS_EXPIRES_IN=15m

# RSA private key ký access token (RS256) — sinh bằng:
#   npm run generate:jwt-keypair
# rồi paste đúng dòng JWT_PRIVATE_KEY="..." nó in ra vào đây.
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
JWT_KEY_ID=auth-key-1

# Gọi sang users-service (tạo/xoá hồ sơ) — INTERNAL_API_KEY phải TRÙNG
# với giá trị trong apps/users-service/.env.
USERS_SERVICE_URL=http://localhost:3002
INTERNAL_API_KEY=doi-chuoi-nay-toi-thieu-32-ky-tu-ngau-nhien-khac

# Optional — social login (#04), báo lỗi rõ ràng khi gọi mà thiếu, không
# chặn khởi động app. Bỏ comment + điền giá trị khi cần dùng.
# GOOGLE_CLIENT_ID=
# APPLE_CLIENT_ID=

# Optional — build link xác thực email (#07) trỏ về FE.
# FE_BASE_URL=

# Optional — thiếu 1 trong 2 biến dưới sẽ tự fallback ConsoleMailerService
# (log email ra console thay vì gửi thật, đủ dùng cho dev/test).
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=
